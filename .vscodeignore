# Development only
.claude/
.vscode/

# Packages - exclude source and other packages, keep vscode/out
packages/types/
packages/api-client/
packages/server/
packages/maid-agent-messenger/
packages/vscode/src/
packages/vscode/node_modules/
packages/vscode/*.ts

# Apps (private repos)
apps/

# Git
.git/
.gitignore
.gitattributes

# Dependencies (installed on demand)
node_modules/
global-templates/maid-agent-messenger/node_modules/

# Build artifacts
**/*.map

# Test files
.vscode-test/
**/*.test.ts
**/*.spec.ts
out/**/__tests__/
packages/vscode/out/**/__tests__/
global-templates/maid-agent-messenger/dist/__tests__/

# Type definitions (not needed at runtime)
global-templates/maid-agent-messenger/dist/**/*.d.ts
packages/vscode/out/**/*.d.ts

# Logs
*.log
**/logs/

# Editor/IDE
*.swp
*.swo
.idea/
*.sublime-*

# OS
.DS_Store
Thumbs.db
