# Source files (bundled by esbuild)
packages/*/src/
packages/*/*.ts
**/*.ts
!packages/vscode/out/**

# All packages except vscode/out
packages/types/
packages/api-client/
packages/server/
packages/constants/
packages/maid-agent-messenger/
packages/vscode/node_modules/

# Development
.claude/
.vscode/
apps/
node_modules/
esbuild.mjs
tsconfig*.json
vitest.config.ts

# Git
.git/
.gitignore
.gitattributes

# Build artifacts (keep extension.js, exclude maps/tests)
**/*.map
**/*.test.ts
**/*.spec.ts
**/out/__tests__/

# Type definitions (bundled)
**/*.d.ts
**/*.d.ts.map
**/*.tsbuildinfo

# Test/dev files
.vscode-test/

# Logs & temp
*.log
**/logs/

# Editor/IDE
*.swp
*.swo
.idea/
*.sublime-*

# OS
.DS_Store
Thumbs.db
