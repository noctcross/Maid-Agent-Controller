# Development only
.claude/
packages/
.vscode/
src/
*.ts
!*.d.ts

# Git
.git/
.gitignore
.gitattributes

# Dependencies (installed on demand)
node_modules/
global-templates/maid-agent-messenger/node_modules/

# Build artifacts
