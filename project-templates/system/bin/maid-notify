#!/usr/bin/env bash
# maid-notify - エージェント間通知CLIツール（直接send-keys方式）
# 使用法: maid-notify <target> "<message>"
#         maid-notify --mcp-reconnect <target> [server-name]

# =============================================================================
# 定数定義
# =============================================================================

MAID_AGENT_DIR=".maid-agent"
SESSION_FILE="${MAID_AGENT_DIR}/system/config/.session-name"
LOG_FILE="${MAID_AGENT_DIR}/system/data/notifications/history.log"
PENDING_DIR="${MAID_AGENT_DIR}/system/data/notifications/pending"
QUEUE_DIR="${MAID_AGENT_DIR}/system/data/notifications/queue"
VALID_TARGETS="butler chief emma sophia lily rose alice may flora luna"

# リトライ設定
MAX_RETRIES=3
RETRY_DELAY=0.5

# =============================================================================
# 環境検出
# =============================================================================

# settings.yaml から multiplexer.type を読み込む
read_multiplexer_from_settings() {
    local settings_file="${MAID_AGENT_DIR}/system/config/settings.yaml"
    if [ -f "$settings_file" ]; then
        local mux_type
        # コメント行を除外して type: の値を取得（CRLFも除去）
        mux_type=$(grep -A10 "^multiplexer:" "$settings_file" 2>/dev/null | grep -v "^[[:space:]]*#" | grep "type:" | head -1 | awk '{print $2}' | tr -d '\r')
        if [ -n "$mux_type" ] && [ "$mux_type" != "auto" ]; then
            echo "$mux_type"
            return 0
        fi
    fi
    return 1
}

# マルチプレクサコマンドを取得
get_multiplexer_command() {
    # 1. settings.yaml から読み込み
    local from_settings
    from_settings=$(read_multiplexer_from_settings)
    if [ -n "$from_settings" ]; then
        echo "$from_settings"
        return 0
    fi

    # 2. 環境変数
    if [ "${MAID_MULTIPLEXER:-}" = "psmux" ]; then
        echo "psmux"
        return 0
    fi

    # 3. 自動検出
    if [ -n "$TMUX" ]; then
        echo "tmux"
    elif command -v psmux &> /dev/null; then
        echo "psmux"
    else
        echo "tmux"
    fi
}

# マルチプレクサコマンドを設定
MUX_CMD=$(get_multiplexer_command)

# 遅延設定（Claude Code がビジー状態でも確実に受け付けるため長めに設定）
MESSAGE_TO_ENTER_DELAY=1.0
ENTER_RETRY_COUNT=2
ENTER_RETRY_DELAY=0.3

# MCP再接続設定
DEFAULT_MCP_SERVER="maid-agent-messenger"
MCP_RECONNECT_DELAY=1.5

# =============================================================================
# 関数定義
# =============================================================================

# 使用法を表示
show_usage() {
    echo "使用法: maid-notify <target> \"<message>\""
    echo "        maid-notify --from <sender> <target> \"<message>\""
    echo "        maid-notify --no-prefix <target> \"<message>\""
    echo "        maid-notify --urgent <target> \"<message>\""
    echo "        maid-notify --mcp-reconnect <target> [server-name]"
    echo ""
    echo "  target: $VALID_TARGETS"
    echo "  --from: 送信者を明示的に指定（API等tmux外からの呼び出し用）"
    echo "  --no-prefix: [From: sender] プレフィックスを付けない（/コマンド用）"
    echo "  --urgent: ビジーチェックをバイパスして即送信（asyncRewake: exit 2 を返す）"
    echo ""
    echo "例:"
    echo "  maid-notify chief \"タスク完了しました\""
    echo "  maid-notify --from master luna \"メッセージです\""
    echo "  maid-notify --no-prefix emma \"/skill maid-operation\""
    echo "  maid-notify --urgent chief \"緊急: サーバーダウン\""
    echo "  maid-notify --mcp-reconnect luna"
    echo "  maid-notify --mcp-reconnect alice other-mcp-server"
}

# ターゲットの有効性をチェック
validate_target() {
    local target="$1"
    if ! echo "$VALID_TARGETS" | grep -qw "$target"; then
        echo "エラー: 無効なターゲット '$target'"
        echo "有効なターゲット: $VALID_TARGETS"
        return 1
    fi
    return 0
}

# ターゲットがオンラインかチェック
check_target_online() {
    local target="$1"
    $MUX_CMD list-windows -t "$SESSION_NAME" -F '#{window_name}' 2>/dev/null | grep -qx "$target"
}

# スクロールモードを解除
cancel_scroll_mode() {
    local target="$1"
    $MUX_CMD send-keys -t "${SESSION_NAME}:${target}" -X cancel 2>/dev/null || true
    $MUX_CMD send-keys -t "${SESSION_NAME}:${target}" Escape 2>/dev/null || true
    sleep 0.2
}

# テキストを送信してEnter
send_text_with_enter() {
    local target="$1"
    local text="$2"
    $MUX_CMD send-keys -t "${SESSION_NAME}:${target}" -l "$text" 2>/dev/null
    sleep $MESSAGE_TO_ENTER_DELAY
    $MUX_CMD send-keys -t "${SESSION_NAME}:${target}" C-m 2>/dev/null
}

# MCP再接続を実行
execute_mcp_reconnect() {
    local target="$1"
    local server_name="$2"

    echo "MCP再接続を実行中: $target ($server_name)..."

    # スクロールモード解除
    cancel_scroll_mode "$target"

    # /mcp disable 送信
    send_text_with_enter "$target" "/mcp disable $server_name"
    sleep $MCP_RECONNECT_DELAY

    # /mcp enable 送信
    send_text_with_enter "$target" "/mcp enable $server_name"
    sleep $MCP_RECONNECT_DELAY

    # 通知メッセージ送信（相手が気付けるように）
    send_text_with_enter "$target" "[MCP再接続完了]"

    echo "MCP再接続を実行しました: $target ($server_name)"
}

# メッセージ送信（リトライ機構付き）
send_message() {
    local target="$1"
    local message="$2"
    local attempt=1
    local success=false

    while [ $attempt -le $MAX_RETRIES ] && [ "$success" = "false" ]; do
        # スクロールモード解除
        cancel_scroll_mode "$target"

        # メッセージ送信を試行
        if $MUX_CMD send-keys -t "${SESSION_NAME}:${target}" -l "$message" 2>/dev/null; then
            sleep $MESSAGE_TO_ENTER_DELAY

            # Enter送信（複数回試行）
            local enter_attempt=1
            while [ $enter_attempt -le $ENTER_RETRY_COUNT ]; do
                if $MUX_CMD send-keys -t "${SESSION_NAME}:${target}" C-m 2>/dev/null; then
                    if [ $enter_attempt -lt $ENTER_RETRY_COUNT ]; then
                        sleep $ENTER_RETRY_DELAY
                    fi
                fi
                enter_attempt=$((enter_attempt + 1))
            done
            success=true
        fi

        if [ "$success" = "false" ]; then
            if [ $attempt -lt $MAX_RETRIES ]; then
                echo "送信失敗（試行 $attempt/$MAX_RETRIES）、リトライ中..."
                sleep $RETRY_DELAY
            fi
            attempt=$((attempt + 1))
        fi
    done

    [ "$success" = "true" ]
}

# ターゲットエージェントのビジー状態を確認（maid.yaml の claude_status を参照）
check_agent_busy() {
    local target="$1"
    local maid_yaml="${MAID_AGENT_DIR}/system/data/maid/${target}.yaml"
    if [ -f "$maid_yaml" ]; then
        local status
        status=$(grep "^claude_status:" "$maid_yaml" 2>/dev/null | awk '{print $2}' | tr -d '\r')
        [ "$status" = "busy" ]
    else
        return 1  # maid.yaml なし = 状態不明 → 送信を試みる
    fi
}

# ビジーキューにメッセージを追加（flock 排他・無制限 append）
# 改行入りメッセージは \n にエスケープして1行に収める（1 notify = 1行 = notify 単位保証）
enqueue_busy_message() {
    local target="$1"
    local message="$2"
    local timestamp="$3"
    local sender="$4"

    mkdir -p "$QUEUE_DIR"
    local queue_file="${QUEUE_DIR}/${target}.txt"
    local lock_file="${QUEUE_DIR}/${target}.lock"

    # 改行を \n（リテラル）にエスケープして1行1エントリを保証（task-973）
    local msg_escaped="${message//$'\n'/\\n}"

    (
        flock -x 9
        echo "[${timestamp}] ${sender}: ${msg_escaped}" >> "$queue_file"
    ) 9>"$lock_file"
}

# =============================================================================
# 引数チェック（最低限）
# =============================================================================

if [ $# -lt 1 ]; then
    show_usage
    exit 1
fi

# =============================================================================
# 共通初期化処理
# =============================================================================

# .maid-agent ディレクトリが存在するか確認
if [ ! -d "$MAID_AGENT_DIR" ]; then
    echo "エラー: .maid-agent ディレクトリが見つかりません"
    echo "プロジェクトルートで実行してください"
    exit 1
fi

# セッション名を取得
if [ ! -f "$SESSION_FILE" ]; then
    echo "エラー: セッション名ファイルが見つかりません: $SESSION_FILE"
    echo "拡張機能からエージェントを起動してください"
    exit 1
fi

SESSION_NAME=$(cat "$SESSION_FILE")

# =============================================================================
# メイン処理：--mcp-reconnect オプション
# =============================================================================

if [ "$1" = "--mcp-reconnect" ]; then
    if [ $# -lt 2 ]; then
        echo "使用法: maid-notify --mcp-reconnect <target> [server-name]"
        exit 1
    fi

    TARGET="$2"
    SERVER_NAME="${3:-$DEFAULT_MCP_SERVER}"

    # ターゲット検証
    validate_target "$TARGET" || exit 1

    # オンラインチェック
    if ! check_target_online "$TARGET"; then
        echo "エラー: $TARGET はオフラインです"
        exit 1
    fi

    # 実行
    execute_mcp_reconnect "$TARGET" "$SERVER_NAME"
    exit 0
fi

# =============================================================================
# メイン処理：通常のメッセージ送信
# =============================================================================

# オプションのパース
EXPLICIT_SENDER=""
NO_PREFIX=false
URGENT=false

while [ $# -gt 0 ]; do
    case "$1" in
        --from)
            if [ $# -lt 4 ]; then
                echo "使用法: maid-notify --from <sender> <target> \"<message>\""
                exit 1
            fi
            EXPLICIT_SENDER="$2"
            shift 2  # --from と sender を消費
            ;;
        --no-prefix)
            NO_PREFIX=true
            shift
            ;;
        --urgent)
            URGENT=true
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -lt 2 ]; then
    show_usage
    exit 1
fi

TARGET="$1"
MESSAGE="$2"

# ターゲット検証
validate_target "$TARGET" || exit 1

# 送信者を特定
if [ -n "$EXPLICIT_SENDER" ]; then
    # --from で明示的に指定された場合
    SENDER="$EXPLICIT_SENDER"
elif [ -n "$TMUX_PANE" ]; then
    # tmux/psmux内から実行された場合
    SENDER=$($MUX_CMD display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || echo "unknown")
else
    # それ以外は unknown
    SENDER="unknown"
fi

# タイムスタンプを取得
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# ログディレクトリを作成
mkdir -p "$(dirname "$LOG_FILE")"

# ログローテーション（1000行を超えたら古い500行を削除）
if [ -f "$LOG_FILE" ] && [ $(wc -l < "$LOG_FILE" 2>/dev/null || echo 0) -gt 1000 ]; then
    tail -n 500 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
fi

# ログに記録
echo "[$TIMESTAMP] $SENDER → $TARGET: $MESSAGE" >> "$LOG_FILE"

# オンラインチェック
if ! check_target_online "$TARGET"; then
    # オフライン: 保留キューに追加
    mkdir -p "$PENDING_DIR"
    PENDING_FILE="${PENDING_DIR}/${TARGET}.txt"
    echo "[$TIMESTAMP] $SENDER: $MESSAGE" >> "$PENDING_FILE"
    echo "警告: $TARGET はオフラインです。メッセージを保留キューに追加しました。"
    echo "[$TIMESTAMP] [PENDING] $SENDER → $TARGET (offline): $MESSAGE" >> "$LOG_FILE"
    exit 2
fi

# 送信実行
if [ "$NO_PREFIX" = true ]; then
    FULL_MESSAGE="$MESSAGE"
else
    FULL_MESSAGE="[From: $SENDER] $MESSAGE"
fi

# 緊急レーン（--urgent）: ビジーチェックをバイパスして即送信
if [ "$URGENT" = true ]; then
    if send_message "$TARGET" "$FULL_MESSAGE"; then
        echo "[$TIMESTAMP] [URGENT] $SENDER → $TARGET: $MESSAGE" >> "$LOG_FILE"
        echo "緊急通知を送信しました（asyncRewake）: $SENDER → $TARGET"
        exit 2  # asyncRewake シグナル
    else
        echo "エラー: 緊急通知の送信に失敗しました（$MAX_RETRIES 回試行）"
        echo "[$TIMESTAMP] [ERROR] 緊急送信失敗: $SENDER → $TARGET: $MESSAGE" >> "$LOG_FILE"
        exit 1
    fi
fi

# ビジーチェック: ターゲットがビジー状態なら queue に積む
if check_agent_busy "$TARGET"; then
    enqueue_busy_message "$TARGET" "$FULL_MESSAGE" "$TIMESTAMP" "$SENDER"
    echo "[$TIMESTAMP] [QUEUED] $SENDER → $TARGET (busy): $MESSAGE" >> "$LOG_FILE"
    echo "通知をキューに追加しました（ビジー中）: $SENDER → $TARGET"
    exit 0
fi

# trigger A: idle 状態でキューに残存メッセージがあれば即まとめフラッシュ
QUEUE_FILE_A="${QUEUE_DIR}/${TARGET}.txt"
if [ -f "$QUEUE_FILE_A" ] && [ -s "$QUEUE_FILE_A" ]; then
    enqueue_busy_message "$TARGET" "$FULL_MESSAGE" "$TIMESTAMP" "$SENDER"
    echo "[$TIMESTAMP] [TRIGGER_A] $SENDER → $TARGET (idle+queue): $MESSAGE" >> "$LOG_FILE"
    echo "通知をキューに追加してまとめフラッシュします: $SENDER → $TARGET"
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash "${SCRIPT_DIR}/flush-notify-queue.sh" "$TARGET" "$(pwd)"
    exit 0
fi

if send_message "$TARGET" "$FULL_MESSAGE"; then
    echo "通知を送信しました: $SENDER → $TARGET"
else
    echo "エラー: 通知の送信に失敗しました（$MAX_RETRIES 回試行）"
    echo "[$TIMESTAMP] [ERROR] 送信失敗: $SENDER → $TARGET: $MESSAGE" >> "$LOG_FILE"
    exit 1
fi
