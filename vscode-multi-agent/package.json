{
  "name": "multi-agent-controller",
  "displayName": "Maid Agent Controller",
  "description": "VSCode extension for multi-agent Claude Code orchestration with Maid team",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "multiAgent.startAgents",
        "title": "Maid Agent: Start Head & Chief Maid"
      },
      {
        "command": "multiAgent.startMaids",
        "title": "Maid Agent: Start 8 Maids"
      },
      {
        "command": "multiAgent.startAll",
        "title": "Maid Agent: Start All (10 Maids)"
      },
      {
        "command": "multiAgent.sendToChief",
        "title": "Maid Agent: Send Command to Chief Maid"
      },
      {
        "command": "multiAgent.sendToMaid",
        "title": "Maid Agent: Send Command to Maid"
      },
      {
        "command": "multiAgent.startClaude",
        "title": "Maid Agent: Start Claude on All Maids"
      },
      {
        "command": "multiAgent.showDashboard",
        "title": "Maid Agent: Show Dashboard"
      },
      {
        "command": "multiAgent.watchTaskFile",
        "title": "Maid Agent: Start Watching Task File"
      },
      {
        "command": "multiAgent.stopWatchTaskFile",
        "title": "Maid Agent: Stop Watching Task File"
      },
      {
        "command": "multiAgent.createSampleTask",
        "title": "Maid Agent: Create Sample Task File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
