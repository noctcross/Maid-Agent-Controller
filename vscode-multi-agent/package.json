{
  "name": "multi-agent-controller",
  "displayName": "Maid Agent Controller",
  "description": "VSCode extension for multi-agent Claude Code orchestration (multi-agent-shogun style)",
  "version": "0.5.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "multiAgent.initialize",
        "title": "Maid Agent: Init"
      },
      {
        "command": "multiAgent.startButler",
        "title": "Maid Agent: Call Butler"
      },
      {
        "command": "multiAgent.startChiefMaid",
        "title": "Maid Agent: Call Chief"
      },
      {
        "command": "multiAgent.startAgents",
        "title": "Maid Agent: Call Butler & Chief"
      },
      {
        "command": "multiAgent.startSelectedMaids",
        "title": "Maid Agent: Call Maids Pick"
      },
      {
        "command": "multiAgent.startMaidsByCount",
        "title": "Maid Agent: Call Maids xN"
      },
      {
        "command": "multiAgent.startMaidsByCountRandom",
        "title": "Maid Agent: Call Maids xN -r"
      },
      {
        "command": "multiAgent.startAll",
        "title": "Maid Agent: Call All"
      },
      {
        "command": "multiAgent.startAllByCount",
        "title": "Maid Agent: Call All xN"
      },
      {
        "command": "multiAgent.startAllByCountRandom",
        "title": "Maid Agent: Call All xN -r"
      },
      {
        "command": "multiAgent.sendToButler",
        "title": "Maid Agent: Task to Butler"
      },
      {
        "command": "multiAgent.sendToMaid",
        "title": "Maid Agent: Task to Maid"
      },
      {
        "command": "multiAgent.startClaude",
        "title": "Maid Agent: Claude Start"
      },
      {
        "command": "multiAgent.showDashboard",
        "title": "Maid Agent: Dashboard"
      },
      {
        "command": "multiAgent.watchFiles",
        "title": "Maid Agent: Watch Start"
      },
      {
        "command": "multiAgent.stopWatchFiles",
        "title": "Maid Agent: Watch Stop"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maidAgentContainer",
          "title": "Maid Agent",
          "icon": "$(heart)"
        }
      ]
    },
    "views": {
      "maidAgentContainer": [
        {
          "type": "webview",
          "id": "maidAgent.agentPanel",
          "name": "Current Agent",
          "when": "config.maidAgent.showAgentPanel"
        }
      ]
    },
    "configuration": {
      "title": "Maid Agent",
      "properties": {
        "maidAgent.maidOrder": {
          "type": "array",
          "default": ["emma", "sophia", "lily", "rose", "alice", "may", "flora", "luna"],
          "items": {
            "type": "string",
            "enum": ["emma", "sophia", "lily", "rose", "alice", "may", "flora", "luna"]
          },
          "description": "メイドの起動順序（順番起動時に使用）"
        },
        "maidAgent.showAgentPanel": {
          "type": "boolean",
          "default": true,
          "description": "サイドバーにエージェントパネルを表示"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
